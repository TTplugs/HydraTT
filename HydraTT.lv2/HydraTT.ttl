@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<urn:asier:lv2:hydratt>
    a lv2:Plugin, lv2:InstrumentPlugin ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
    doap:name "HydraTT" ;
    doap:license "GPL-2.0-only" ;
    doap:maintainer [ foaf:name "TTLab" ] ;
    mod:brand "TTLab" ;
    mod:label "HydraTT" ;
    lv2:minorVersion 0 ;
    lv2:microVersion 1 ;

    lv2:port
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ; lv2:designation lv2:control ; atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
    [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "osc1_wave" ; lv2:name "OSC1_Wave" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 4 ;
      lv2:scalePoint [ rdfs:label "Saw" ; rdf:value 0 ] , [ rdfs:label "Triangle" ; rdf:value 1 ] , [ rdfs:label "Pulse" ; rdf:value 2 ] , [ rdfs:label "Sine" ; rdf:value 3 ] , [ rdfs:label "Mutant" ; rdf:value 4 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "osc1_shape" ; lv2:name "OSC1_Shape" ; lv2:default 0.35 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "osc1_pw" ; lv2:name "OSC1_PW" ; lv2:default 0.50 ; lv2:minimum 0.05 ; lv2:maximum 0.95 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "osc1_oct" ; lv2:name "OSC1_Oct" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -2 ; lv2:maximum 2 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "osc1_semi" ; lv2:name "OSC1_Semi" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "osc1_detune" ; lv2:name "OSC1_Detune" ; lv2:default 0.00 ; lv2:minimum -50.00 ; lv2:maximum 50.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 9 ; lv2:symbol "osc2_wave" ; lv2:name "OSC2_Wave" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 4 ; lv2:minimum 0 ; lv2:maximum 4 ;
      lv2:scalePoint [ rdfs:label "Saw" ; rdf:value 0 ] , [ rdfs:label "Triangle" ; rdf:value 1 ] , [ rdfs:label "Pulse" ; rdf:value 2 ] , [ rdfs:label "Sine" ; rdf:value 3 ] , [ rdfs:label "Mutant" ; rdf:value 4 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 10 ; lv2:symbol "osc2_level" ; lv2:name "OSC2_Level" ; lv2:default 0.80 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "osc2_oct" ; lv2:name "OSC2_Oct" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -2 ; lv2:maximum 2 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "osc2_semi" ; lv2:name "OSC2_Semi" ; lv2:portProperty lv2:integer ; lv2:default 0 ; lv2:minimum -12 ; lv2:maximum 12 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "osc2_detune" ; lv2:name "OSC2_Detune" ; lv2:default 0.00 ; lv2:minimum -50.00 ; lv2:maximum 50.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "osc_sync" ; lv2:name "OSC_Sync" ; lv2:portProperty lv2:integer, lv2:toggled ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 15 ; lv2:symbol "fm_amount" ; lv2:name "FM_Amount" ; lv2:default 0.20 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 16 ; lv2:symbol "sub_level" ; lv2:name "SUB_Level" ; lv2:default 0.20 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 17 ; lv2:symbol "noise_level" ; lv2:name "NOISE_Level" ; lv2:default 0.03 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 18 ; lv2:symbol "mix_balance" ; lv2:name "MIX_Balance" ; lv2:default 0.00 ; lv2:minimum -1.00 ; lv2:maximum 1.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 19 ; lv2:symbol "filter_mode" ; lv2:name "FILTER_Mode" ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
      lv2:scalePoint [ rdfs:label "LowPass" ; rdf:value 0 ] , [ rdfs:label "BandPass" ; rdf:value 1 ] , [ rdfs:label "HighPass" ; rdf:value 2 ] ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 20 ; lv2:symbol "filter_cutoff" ; lv2:name "FILTER_Cutoff" ; lv2:portProperty pprops:logarithmic ; lv2:default 9500.00 ; lv2:minimum 20.00 ; lv2:maximum 20000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 21 ; lv2:symbol "filter_resonance" ; lv2:name "FILTER_Resonance" ; lv2:default 0.22 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 22 ; lv2:symbol "filter_env_amt" ; lv2:name "FILTER_EnvAmt" ; lv2:default 26.00 ; lv2:minimum -48.00 ; lv2:maximum 48.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 23 ; lv2:symbol "env_attack" ; lv2:name "ENV_Attack" ; lv2:portProperty pprops:logarithmic ; lv2:default 3.00 ; lv2:minimum 0.50 ; lv2:maximum 5000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 24 ; lv2:symbol "env_decay" ; lv2:name "ENV_Decay" ; lv2:portProperty pprops:logarithmic ; lv2:default 520.00 ; lv2:minimum 1.00 ; lv2:maximum 8000.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 25 ; lv2:symbol "env_sustain" ; lv2:name "ENV_Sustain" ; lv2:default 0.72 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 26 ; lv2:symbol "env_release" ; lv2:name "ENV_Release" ; lv2:portProperty pprops:logarithmic ; lv2:default 950.00 ; lv2:minimum 1.00 ; lv2:maximum 12000.00 ] ,

    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 27 ; lv2:symbol "lfo_rate" ; lv2:name "LFO_Rate" ; lv2:portProperty pprops:logarithmic ; lv2:default 2.40 ; lv2:minimum 0.05 ; lv2:maximum 40.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 28 ; lv2:symbol "lfo_depth" ; lv2:name "LFO_Depth" ; lv2:default 0.28 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 29 ; lv2:symbol "velocity_amt" ; lv2:name "Velocity_Amount" ; lv2:default 0.70 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 30 ; lv2:symbol "drive" ; lv2:name "Drive" ; lv2:default 0.16 ; lv2:minimum 0.00 ; lv2:maximum 1.00 ] ,
    [ a lv2:InputPort, lv2:ControlPort ; lv2:index 31 ; lv2:symbol "glide_ms" ; lv2:name "Glide_ms" ; lv2:default 0.00 ; lv2:minimum 0.00 ; lv2:maximum 500.00 ] .
